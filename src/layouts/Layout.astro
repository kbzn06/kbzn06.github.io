---
import "../styles/global.css";

const { titulo = "Un poco de nosotros 🌷🦥", protegida = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <script is:inline>
  const navegacion = performance.getEntriesByType("navigation")[0];

  if (navegacion?.type === "reload") {
    localStorage.removeItem("our13-pin-ok");
  }
</script>
    <meta charset="utf-8" />
    {protegida && (
      <script is:inline>
       if (localStorage.getItem("our13-pin-ok") !== "ok")  {
          location.replace("/quiz");
        }
      </script>
    )}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{titulo}</title>
  </head>
  <body>
    <slot />
  </body>
</html>