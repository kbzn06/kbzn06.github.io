---
// Stickers decorativos. Para añadir uno, copia una línea y cambia los valores:
// posición (top/bottom/left/right) · --ancho: tamaño · --giro: inclinación
// --retraso: desfase del flotar · --entrada: cuándo aparece
const stickers = [
  { src: "/images/deco/dentista.png", estilo: "bottom: 4%; left: 4%; --ancho: clamp(90px, 18vw, 200px); --giro: -4deg;" },
 
 
];
---

<div class="hero">
  <video class="hero__video" autoplay muted loop playsinline aria-hidden="true">
    <source src="/video/fondo.mp4" type="video/mp4" />
  </video>
  <div class="hero__velo"></div>

  {stickers.map((s) => (
    <img class="sticker" src={s.src} alt="" aria-hidden="true" style={s.estilo} />
  ))}

  <p class="eyebrow">12 días</p>

  <h1>I love you <br />like all fire</h1>

  <p class="description">Un lugar hecho solo para ti</p>

  <a href="/quiz" class="portal" aria-label="Entrar">
    <img src="/images/deco/tulip.png" alt="" class="decotulip" />
  </a>
  <p class="pista">meu amor</p>
</div>

<style>
  .hero {
    justify-content: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem;
    box-sizing: border-box;
    background: var(--degradado-amanecer);
    color: var(--color-texto);
  }

  /* Capas del fondo: video (-3), velo de color (-2), stickers (-1). El texto queda encima. */
  .hero__video {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(var(--desenfoque-video));
    scale: 1.1;
  }
  .hero__velo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: var(--degradado-amanecer);
    opacity: var(--opacidad-velo);
  }

  .sticker {
    position: absolute;
    z-index: -1;
    width: var(--ancho, clamp(60px, 12vw, 140px));
    height: auto;
    pointer-events: none;
    rotate: var(--giro, 0deg);
    animation:
      surgir 2.4s ease-out var(--entrada, 1s) both,
      deriva 6s ease-in-out var(--retraso, 0s) infinite;
  }

  .eyebrow {
    font-family: "Bank Gothic", sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.18rem;
    text-transform: uppercase;
    margin-bottom: 1rem;
    animation: aparecer 2.4s ease-out both;
  }

  h1 {
    font-family: "Bank Gothic", sans-serif;
    font-size: clamp(2rem, 7vw, 5rem);
    line-height: 0.95;
    margin: 0;
    font-weight: bold;
    animation: aparecer 2.4s ease-out 0.5s both;
  }

  .description {
    font-family: "Bank Gothic", sans-serif;
    max-width: 450px;
    margin-top: 1.5rem;
    font-size: 1.1rem;
    line-height: 1.6;
    animation: aparecer 2.4s ease-out 1.1s both;
  }

  .portal {
    display: inline-block;
    margin-top: 2rem;
    animation:
      aparecer 2.4s ease-out 1.7s both,
      pulso 2.4s ease-in-out 4.2s infinite;
  }
  .portal:focus-visible {
    outline: 2px dashed var(--color-texto);
    outline-offset: 8px;
    border-radius: 50%;
  }

  .decotulip {
    display: block;
    width: clamp(90px, 14vw, 180px);
    height: auto;
    transition: transform 0.3s ease;
  }
  .portal:hover .decotulip {
    transform: scale(1.15) rotate(-4deg);
  }

  .pista {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    opacity: 0.6;
  }

  /* Entrada: usa opacity y translate (propiedades sueltas) para no pisar al transform del pulso */
  @keyframes aparecer {
    from { opacity: 0; translate: 0 16px; }
    to { opacity: 1; translate: 0 0; }
  }
  @keyframes surgir {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes deriva {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -12px; }
  }
  @keyframes pulso {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video { display: none; }
    .eyebrow, h1, .description, .portal, .sticker { animation: none; }
  }
</style>