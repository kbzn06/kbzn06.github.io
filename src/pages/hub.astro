---
import Layout from "../layouts/Layout.astro";

const secciones = [
  { href: "/carrete", icono: "/images/iconos/carrete.png", titulo: "Carrete" },
  { href: "/dias", icono: "/images/iconos/dias.png", titulo: "12 días" },
  { href: "/canciones", icono: "/images/iconos/canciones.png", titulo: "Canciones" },
];
import VolverTulipan from "../components/VolverTulipan.astro";

---

<Layout titulo="Hub 🌷" protegida={true}>
  <main class="pantalla pantalla--centro" style="background: var(--fondo-hub);">
    <VolverTulipan destino="/" etiqueta="Volver al inicio" />
    <h1 class="titulo-pagina">¿Por dónde empezamos?</h1>

    <nav class="menu">
      {secciones.map((s) => (
        <a href={s.href} class="icono">
          <img src={s.icono} alt="" />
          <span class="icono__nombre">{s.titulo}</span>
        </a>
      ))}
    </nav>
  </main>
</Layout>

<style>
  .pantalla {
  min-height: 100vh;
  min-height: 100dvh;
  box-sizing: border-box;
  padding: 4rem 1.5rem 2rem;
  background: var(--degradado-amanecer);
  color: var(--color-texto);
}

.pantalla--centro {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-block: 2rem;
}
  h1 {
    margin: 0 0 2.5rem;
    font-family: "Bank Gothic", sans-serif;
    font-size: clamp(1.8rem, 6vw, 3rem);
  }

.menu {
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: flex-start;
  gap: clamp(1rem, 5vw, 3rem);
}

  .icono {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.25s ease;
  }

.icono img {
  display: block;
  width: clamp(64px, 22vw, 120px);
  height: auto;
  filter: drop-shadow(0 6px 10px rgb(63 64 56 / 0.25));
  transition: filter 0.25s ease;
  animation: flotar 3.2s ease-in-out infinite;
}
.icono:nth-child(2) img { animation-delay: -1.1s; }
.icono:nth-child(3) img { animation-delay: -2.2s; }

.icono__nombre {
  font-size: clamp(0.6rem, 2.4vw, 0.8rem);
  letter-spacing: 0.08rem;
    text-transform: uppercase;
    opacity: 0.7;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .icono:hover {
    transform: translateY(-6px) scale(1.08);
  }
  .icono:hover img {
    filter: drop-shadow(0 14px 16px rgb(63 64 56 / 0.3)) saturate(1.15);
  }
  .icono:active {
    transform: translateY(0) scale(0.92);
    transition-duration: 0.08s;
  }

  .icono:focus-visible {
    outline: 2px dashed var(--color-texto);
    outline-offset: 10px;
    border-radius: 1rem;
  }

  @media (hover: hover) {
    .icono__nombre {
      opacity: 0;
      transform: translateY(-4px);
    }
    .icono:hover .icono__nombre,
    .icono:focus-visible .icono__nombre {
      opacity: 0.8;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .icono, .icono img, .icono__nombre { transition: none; }
     .icono img { animation: none; }
  }
  @keyframes flotar {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
</style>